# The Lambdas read these from template.yaml in AWS. Locally, backend/local/dev_server.py
# sets safe values automatically; these are listed for reference only. No secrets here.
TABLE_NAME=cloudworm-local-transfers
BUCKET_NAME=cloudworm-local-files
AWS_REGION=ap-south-1
# SHA-256 hex of the upload access code (scripts/hash-access-code.sh). Never the code itself.
ACCESS_CODE_HASH=
MAX_FILES=50
MAX_FILE_BYTES=2147483648
MAX_TRANSFER_BYTES=5368709120
EXPIRY_HOURS_OPTIONS=1,24,72,168
DEFAULT_EXPIRY_HOURS=24
ALLOWED_EXTENSIONS=
UPLOAD_URL_TTL_SECONDS=900
DOWNLOAD_URL_TTL_SECONDS=300
# Local emulation only:
S3_ENDPOINT_URL=http://127.0.0.1:5005
DYNAMODB_ENDPOINT_URL=http://127.0.0.1:5005
