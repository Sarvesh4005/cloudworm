# Base URL of the CloudWorm HTTP API (no trailing slash).
# Local offline dev server:   http://127.0.0.1:3001
# Deployed stack:             the "ApiUrl" output of `sam deploy`
#                             (scripts/deploy-frontend.sh writes .env.production for you)
# Served by the API itself:   same-origin   (SiteHosting=api; set automatically by
#                             scripts/deploy-backend.sh)
VITE_API_URL=http://127.0.0.1:3001
